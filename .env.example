# Postgres connection (also read by drizzle-kit and the seed script)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/edudesk

# Tenant resolution (docs/multi-tenancy.md)
NUXT_APP_DOMAIN=lvh.me
# Set to serve one school on the bare domain (single-school pilot); leave empty for SaaS mode
NUXT_DEFAULT_SCHOOL_SLUG=

# Seals the session cookie (nuxt-auth-utils); at least 32 characters. `nuxt dev` writes one here if missing.
# Generate one with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
NUXT_SESSION_PASSWORD=
