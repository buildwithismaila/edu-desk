# Production settings for deploy/docker-compose.yml. Copy to deploy/.env on the server and fill in.
# Never commit deploy/.env.

# --- Domain ---------------------------------------------------------------------------------------
# Schools are served at <slug>.<APP_DOMAIN>, e.g. greenfield.edudesk.ng
APP_DOMAIN=edudesk.ng
# Let's Encrypt contact (expiry warnings, problems with certificates)
ACME_EMAIL=you@example.com
# Optional: serve one school on the bare domain too (single-school pilot). Leave empty otherwise.
DEFAULT_SCHOOL_SLUG=

# --- Database -------------------------------------------------------------------------------------
POSTGRES_USER=edudesk
# Long and random: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
POSTGRES_DB=edudesk

# --- Sessions -------------------------------------------------------------------------------------
# Seals the login cookie; at least 32 characters: openssl rand -hex 32
# Changing it logs everyone out.
SESSION_PASSWORD=change-me-to-at-least-32-random-characters

# --- Off-site backups (Cloudflare R2 or any S3-compatible storage) -------------------------------
# Used by the backup service. Leave the bucket empty to keep backups on the server only (NOT for real use).
BACKUP_S3_PROVIDER=Cloudflare
BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=edudesk-backups
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Encrypts every backup before it leaves the server. Store it somewhere safe OFF the server
# (a password manager): without it the backups can't be restored.
BACKUP_PASSPHRASE=change-me
# Hour (0–23, in TZ) for the nightly backup
BACKUP_HOUR=2
TZ=Africa/Lagos
# Optional: a heartbeat URL (e.g. healthchecks.io, UptimeRobot heartbeat) pinged after each good backup,
# so you get an alert if backups stop
BACKUP_HEARTBEAT_URL=
